# ═══════════════════════════════════════════════════════════════════
# Sistema OSINT ML1 — Conflicto Irán-Israel-EE.UU.
# Copiar este archivo a .env y completar los valores reales.
# Nunca subir .env a Git (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ── NASA FIRMS ─────────────────────────────────────────────────────
# Obtener en: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_KEY=

# ── OpenSky Network (OAuth2 client credentials) ────────────────────
# Registrar en: https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Bluesky Social ─────────────────────────────────────────────────
# Handle de la cuenta (ej: usuario.bsky.social)
# App password desde: Configuración → App Passwords
BLUESKY_HANDLE=
BLUESKY_PASSWORD=

# ── ACLED (opcional — no activo en el pipeline principal) ──────────
# Registrar en: https://acleddata.com/access-data/
ACLED_EMAIL=
ACLED_KEY=

# ── Supabase ───────────────────────────────────────────────────────
# Estas variables también van en dashboard/.env.local con el prefijo NEXT_PUBLIC_
# Obtener en: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://iswknjfskqiemxgpalui.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── GDELT — sin clave requerida (API pública) ──────────────────────
# ── RSS Feeds — sin clave requerida (feeds públicos) ───────────────
